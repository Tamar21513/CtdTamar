POSTGRES_DB=ctd
POSTGRES_USER=ctd
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

API_GATEWAY_PORT=8000
CTD_GAME_SERVER_HOST=host.docker.internal
CTD_GAME_SERVER_PORT=5050
CTD_SHARD_LAUNCHER_HOST=host.docker.internal
CTD_SHARD_LAUNCHER_PORT=5100
CTD_MAX_DYNAMIC_SHARDS=50
# Optional additional game server shards (comma-separated host:port),
# each one an independent ctd_server.exe instance on its own port:
# CTD_GAME_SERVER_SHARDS=192.168.1.101:5051,192.168.1.101:5052
# Optional dynamic shard launcher (a separate native process, see
# docs/SHARD_LAUNCHER.md) — leave CTD_SHARD_LAUNCHER_HOST empty to
# disable dynamic spawning entirely and only use the static shards above.
# CTD_SHARD_LAUNCHER_HOST=host.docker.internal
# CTD_SHARD_LAUNCHER_PORT=5100
# CTD_MAX_DYNAMIC_SHARDS=50

SESSION_COOKIE_NAME=ctd_session
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

LOG_DIR=/app/logs
